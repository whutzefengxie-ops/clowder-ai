# One-time source deployment preset; this file is not an automatically loaded dotenv file.
# Run prepare-intranet-deployment.mjs --host-root <absolute Host directory> once.
# Explicit existing strict/required and audit paths are preserved.
CAT_CAFE_WINDOWS_ACP_BOOTSTRAP_MODE=trusted-host
CAT_CAFE_ACP_BOOTSTRAP_CONFIG_AUDIT_MODE=warn-bootstrap-root
# Windows ACP ancestor compatibility; private root ACLs and direct localhost owner management remain required.
# This template never supplies credentials, per-agent bypass permissions, or a machine-specific audit path.
